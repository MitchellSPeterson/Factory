{
  "name": "factory",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx npm-run-all --parallel dev:frontend dev:backend dev:worker",
    "dev:frontend": "vite --host",
    "dev:expo": "bun --cwd expo start --web",
    "dev:backend": "convex dev",
    "dev:worker": "bun --watch worker/index.ts",
    "worker": "bun worker/index.ts",
    "build": "tsc -b && vite build",
    "check": "bun test worker/managed.test.ts worker/github.test.ts worker/jobState.test.ts worker/liveLog.test.ts worker/recipeGraph.test.ts worker/openaiAgent.test.ts worker/codexAgent.test.ts worker/grokAgent.test.ts worker/mcpStdio.test.ts src/github/connectionState.test.ts src/pages/settingsReadiness.test.ts src/jobsBoard.test.ts src/jobsProgress.test.ts src/jobNeed.test.ts src/contextViewer.test.ts && vitest run && tsc --noEmit && tsc --noEmit -p convex/tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "verify": "bun scripts/verify-factory.ts",
    "build:device-stream": "bun scripts/build-device-stream.ts",
    "build:terminal": "bun scripts/build-terminal.ts",
    "dev:device-hub": "expo-device-hub --host 0.0.0.0 --port 3400 --transport webrtc --video-fps 60 --video-bitrate 8000000 --max-dimension 1080"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0",
    "@openai/codex-sdk": "^0.153.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "convex": "^1.25.0",
    "expo-device-hub": "0.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "convex-test": "^0.0.56",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.0"
  },
  "trustedDependencies": [
    "node-datachannel"
  ]
}
