{
  "name": "factory",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx npm-run-all --parallel dev:frontend dev:backend dev:worker",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "dev:worker": "bun --watch worker/index.ts",
    "worker": "bun worker/index.ts",
    "build": "tsc -b && vite build",
    "check": "bun test worker/jobState.test.ts worker/liveLog.test.ts && tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "verify": "bun scripts/verify-factory.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0",
    "convex": "^1.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
