{
  "name": "factory",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx npm-run-all --parallel dev:expo dev:worker",
    "dev:expo": "bun --cwd expo start --web",
    "dev:worker": "bun --watch worker/index.ts",
    "worker": "bun worker/index.ts",
    "kill:workers": "pkill -f \"worker/index.ts\" || echo \"no workers running\"",
    "build:web": "cd expo && bunx expo export -p web",
    "build": "tsc --noEmit -p expo/tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "check": "bun test worker shared expo/src && bun run build",
    "verify": "bun scripts/verify-factory.ts",
    "factory": "bun worker/index.ts",
    "desktop": "bash desktop/build.sh",
    "build:device-stream": "bun scripts/build-device-stream.ts",
    "dev:device-hub": "expo-device-hub --host 0.0.0.0 --port 3400 --transport webrtc --video-fps 60 --video-bitrate 8000000 --max-dimension 1080",
    "build:terminal": "bun scripts/build-terminal.ts",
    "postinstall": "node scripts/prepare-terminal.cjs"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0",
    "@openai/codex-sdk": "^0.153.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "expo-device-hub": "0.10.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "npm-run-all": "^4.1.5",
    "serve-sim": "0.1.47-beta.128.1",
    "typescript": "^5.8.0"
  },
  "trustedDependencies": [
    "node-datachannel",
    "node-pty"
  ]
}
